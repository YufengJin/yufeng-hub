---
/**
 * /vault/ — the index of the private half.
 *
 * Private notes are NOT a separate kind of page any more: each one is an
 * ordinary entry of the `notes` collection living in the `vault/`
 * namespace, so `[...slug].astro` renders it with the wiki's own layout,
 * sidebar, chapter numbering, taxonomy strip, backlinks and link graph, and
 * it appears on every browse page and in the search palette beside the
 * public notes. This file is only the shelf that shows the private ones on
 * their own.
 *
 * It is a dynamic route on purpose. A static `index.astro` would always be
 * emitted; here `getStaticPaths` returns nothing when the vault repository
 * is not mounted, so on the public build `/vault/` does not exist at all —
 * no page, no empty shelf, no 404 stub that admits the namespace is real.
 */
import { getCollection } from 'astro:content';
import NoteCard from 'astro-inkstone/components/wiki/NoteCard.astro';

import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { cardOf } from '../../lib/display';
import { UI } from '../../lib/i18n';
import { isPrivate } from '../../lib/private';
import { getWikiUnits } from '../../lib/taxonomy';

/** the vault is written in the garden's canonical language; an English
 *  index arrives the day an English private note does */
const LOCALE = 'zh' as const;

export async function getStaticPaths() {
  const units = await getWikiUnits();
  if (!units.some((u) => isPrivate(u.id))) return [];
  return [{ params: { slug: undefined } }];
}

const v = UI[LOCALE].vault;
const b = UI[LOCALE].browse;
const units = (await getWikiUnits()).filter((u) => isPrivate(u.id));
const byId = new Map((await getCollection('notes')).map((e) => [e.id, e]));
---

<BrowseLayout
  title={v.title}
  description={v.desc}
  locale={LOCALE}
  crumbs={[{ label: v.title }]}
  alternates={[]}
>
  <header class="wb-hero">
    <p class="wb-kicker">{v.kicker} <span class="sep">·</span> {v.kickerSub}</p>
    <h1 class="wb-title">{v.title}<span class="en">{v.titleSub}</span></h1>
    <p class="wb-lede">{v.lede(units.length)}</p>
  </header>

  <ul class="wb-grid">
    {units.map((note) => <NoteCard note={cardOf(note, LOCALE, byId)} labels={{ chapters: b.chapters }} />)}
  </ul>
</BrowseLayout>
