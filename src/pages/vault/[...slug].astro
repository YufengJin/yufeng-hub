---
/**
 * /vault/ and /vault/<id>/ — the private half of the hub. The collection is
 * populated only where the private repo is actually cloned (the ws02
 * editing machine and private local builds); a public CI checkout has no
 * mount, the collection is empty, and getStaticPaths returns nothing — the
 * whole namespace simply does not exist on the public site.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Base from '../../layouts/Base.astro';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { href } from '../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('vault');
  if (entries.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { entry: null } },
    ...entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
  ];
}

interface Props {
  entry: CollectionEntry<'vault'> | null;
}
const { entry } = Astro.props;
const entries = (await getCollection('vault')).sort(
  (a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0),
);

const fmt = (d?: Date): string =>
  d ? `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}` : '';

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

{
  entry === null ? (
    <BrowseLayout
      title="私密库"
      description="vault——只在自己机器上渲染的私密半区。"
      locale="zh"
      crumbs={[{ label: '私密库' }]}
      alternates={[]}
    >
      <header class="wb-hero">
        <p class="wb-kicker">私密库 <span class="sep">·</span> vault</p>
        <h1 class="wb-title">私密笔记<span class="en">rendered on this machine only</span></h1>
        <p class="wb-lede">共 {entries.length} 篇。这一区不进入公开构建。</p>
      </header>
      <ul class="vault-list">
        {entries.map((e) => (
          <li>
            <a href={href(`vault/${e.id}/`)}>
              <span class="v-title">{e.data.title}</span>
              {e.data.updated && <span class="v-date">{fmt(e.data.updated)}</span>}
              {e.data.description && <span class="v-desc">{e.data.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </BrowseLayout>
  ) : (
    <Base
      title={entry.data.title}
      description={entry.data.description}
      locale="zh"
      crumbs={[{ label: '私密库', route: 'vault/' }, { label: entry.data.title }]}
      alternates={[]}
    >
      <main class="note-main" id="main">
        <div class="col">
          <h1>{entry.data.title}</h1>
          {Content && <Content />}
        </div>
      </main>
    </Base>
  )
}

<style>
  .vault-list {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    max-width: 720px;
  }
  .vault-list a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 18px;
    border: 1px solid var(--wb-line, var(--color-line));
    border-radius: 10px;
    background: var(--wb-card, var(--color-bg-card));
    color: inherit;
    text-decoration: none;
  }
  .vault-list a:hover {
    border-color: var(--color-accent);
  }
  .v-title {
    font: 650 15.5px/1.4 var(--font-body);
    color: var(--color-ink);
  }
  .v-date {
    font: 500 11px/1.4 var(--font-mono);
    color: var(--color-ink-faint);
  }
  .v-desc {
    font: 400 13px/1.6 var(--font-ui);
    color: var(--color-ink-soft);
  }
  main.note-main {
    padding: 56px 64px 120px;
  }
  main.note-main .col {
    max-width: var(--maxw);
    margin: 0 auto;
  }
</style>
