---
/**
 * /papers/ — the paper wall: every poster from paper-snapshots as one card,
 * newest first. Data comes from the `papers` collection (the sparse-cloned
 * meta.json tree); the posters themselves live on the published
 * paper-snapshots site and every card links out to its page there.
 *
 * When the mount is absent (a checkout without the sparse clone) the page
 * still builds — an empty wall with a pointer to the poster site.
 */
import { getCollection } from 'astro:content';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { PAPERS_SITE } from '../../lib/i18n';

const papers = (await getCollection('papers'))
  .map((p) => p.data)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const fmtDate = (d?: string): string => d ?? '';
const posterUrl = (slug: string): string => `${PAPERS_SITE}/${slug}/`;
---

<BrowseLayout
  title="论文墙"
  description={`读过论文的中文图文海报索引——共 ${papers.length} 篇，按时间排列，数据来自 paper-snapshots。`}
  locale="zh"
  crumbs={[{ label: '论文墙' }]}
  alternates={[]}
>
  <header class="wb-hero">
    <p class="wb-kicker">论文墙 <span class="sep">·</span> paper wall</p>
    <h1 class="wb-title">读过的论文<span class="en">poster digests, newest first</span></h1>
    <p class="wb-lede">
      每读一篇论文，产出一张中文图文海报——这里是全部 {papers.length} 张的索引，
      点卡片进入海报页。检索与标签筛选在
      <a href={`${PAPERS_SITE}/`}>paper-snapshots 站</a>更全。
    </p>
  </header>

  {
    papers.length === 0 && (
      <p class="wall-empty">
        本次构建没有挂载论文数据——完整合集在 <a href={`${PAPERS_SITE}/`}>paper-snapshots</a>。
      </p>
    )
  }

  <ul class="wall">
    {
      papers.map((p) => (
        <li class="wall-card">
          <a href={posterUrl(p.slug)}>
            <span class="wall-meta">
              <span class="wall-date">{fmtDate(p.date)}</span>
              {p.category && <span class="wall-cat">{p.category}</span>}
              {p.arxiv_id && <span class="wall-arxiv">arXiv:{p.arxiv_id}</span>}
            </span>
            <span class="wall-title">{p.title_zh ?? p.title ?? p.title_en ?? p.slug}</span>
            {p.title_en && p.title_en !== (p.title_zh ?? p.title) && <span class="wall-title-en">{p.title_en}</span>}
            {p.summary_zh && <span class="wall-summary">{p.summary_zh}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</BrowseLayout>

<style>
  .wall-empty {
    font: 400 15px/1.7 var(--font-ui);
    color: var(--color-ink-soft);
  }
  .wall {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 14px;
  }
  .wall-card a {
    display: flex;
    flex-direction: column;
    gap: 7px;
    height: 100%;
    padding: 16px 18px 15px;
    border: 1px solid var(--wb-line, var(--color-line));
    border-radius: 10px;
    background: var(--wb-card, var(--color-bg-card));
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .wall-card a:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .wall-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    font: 500 11px/1.4 var(--font-mono);
    color: var(--color-ink-faint);
  }
  .wall-cat {
    color: var(--color-accent-text);
  }
  .wall-title {
    font: 650 15.5px/1.45 var(--font-body);
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .wall-title-en {
    font: 400 12.5px/1.45 var(--font-ui);
    color: var(--color-ink-soft);
  }
  .wall-summary {
    font: 400 13px/1.65 var(--font-ui);
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
