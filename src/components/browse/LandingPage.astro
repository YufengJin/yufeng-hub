---
/**
 * The landing page, in one locale — apple.com-homepage shaped: a centered
 * hero, one big tile per section (notes / the paper wall), a domain grid,
 * and a minimal footer. Everything on it comes from the collections; adding
 * a note or a poster changes this page without touching it.
 */
import { existsSync, readdirSync } from 'node:fs';

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { browseHrefFor, localized } from '../../lib/display';
import { browseAlternates, GITHUB_URL, href, localePrefix, UI, type Locale } from '../../lib/i18n';
import { PAPERS_MOUNTED } from '../../lib/papers';
import { isPrivate } from '../../lib/private';
import { getWikiUnits } from '../../lib/taxonomy';
import { DOMAINS } from '../../content/notes/_meta/taxonomy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];
const links = browseHrefFor(locale);
const p = localePrefix(locale);

const units = await getWikiUnits(locale);
// 计数只算公开笔记，和 /all/ 的「共 N 篇」同一口径：总数、方向数、每个
// 方向的篇数都是从整个集合派生的**元数据**，未登录时门禁能剥掉私密卡片，
// 却剥不掉「15 篇」这个数字——首页说 15、列表页说 6，多出来的 9 篇就是
// 私密笔记的存在本身。登录者看到的也是同一组数，两页才对得上。
const publicUnits = units.filter((u) => !isPrivate(u.id));
// 登录者看全量：全量版打 data-private-only（门禁给访客剥掉），公开版紧跟
// 其后打 data-public-twin（site.css 在两者并存时只显示前者）。两个数相等时
// 只出一份。
// 「最近更新」：最新三篇，外加最新三篇**公开**笔记的并集，按时间排。私密
// 条目未登录时被门禁整条剥掉，只取前三的话，访客可能一张卡都剩不下；
// 并集保证访客总有三张，登录者多看到几张更新的私密笔记。
const recentIds = new Set([...units.slice(0, 3), ...publicUnits.slice(0, 3)].map((u) => u.id));
const recent = units.filter((u) => recentIds.has(u.id));
const domainCount = new Set(publicUnits.flatMap((u) => u.domains)).size;
const domainCountAll = new Set(units.flatMap((u) => u.domains)).size;
const hasPrivate = units.length !== publicUnits.length;

// a card titles itself after the note's mirror in the page's locale when one
// exists; its link goes to that mirror, else to the primary edition
const byId = new Map((await getCollection('notes')).map((n) => [n.id, n]));
const editionOf = (u: (typeof units)[number]) => {
  const mirror = byId.get(`${p}${u.id}`);
  return { entry: mirror ?? u.entry, id: mirror ? `${p}${u.id}` : u.id };
};

const papers = (await getCollection('papers'))
  .map((e) => e.data)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

/** first WebP in a poster's img/ dir — the teaser figure */
const coverOf = (slug: string): string | null => {
  const dir = `public/papers/${slug}/img`;
  if (!existsSync(dir)) return null;
  const first = readdirSync(dir)
    .filter((f) => f.endsWith('.webp'))
    .sort()[0];
  return first ? href(`papers/${slug}/img/${first}`) : null;
};
const covers = papers
  .map((e) => ({ slug: e.slug, cover: coverOf(e.slug), title: e.title_zh ?? e.title ?? e.slug }))
  .filter((c) => c.cover)
  .slice(0, 4);

const noteUrl = (id: string): string => href(`${id}/`);
const domainOf = (u: (typeof units)[number]) => u.domains[0] && DOMAINS.find((d) => d.id === u.domains[0]);

const T = {
  zh: {
    eyebrow: '个人知识园地',
    heroSub: '读过、想过、写下来。笔记、论文与项目记录，都在这里生长。',
    ctaNotes: '浏览笔记',
    ctaPapers: '看论文墙',
    notesTitle: '笔记园地',
    notesSub: (n: number, d: number) => `${n} 篇笔记 · ${d} 个方向 · 按形式、方向与标签浏览`,
    notesLink: '全部笔记',
    recentLabel: '最近更新',
    papersTitle: '论文墙',
    papersSub: `${papers.length} 张中文图文海报，每读一篇论文就多一张`,
    papersLink: '进入论文墙',
    domainsTitle: '按方向探索',
    domainCountOf: (n: number) => `${n} 篇`,
    domainEmpty: '待播种',
    searchHint: '全站搜索',
  },
  en: {
    eyebrow: 'A personal knowledge garden',
    heroSub: 'Read, thought through, written down. Notes, papers and project records — all growing here.',
    ctaNotes: 'Browse notes',
    ctaPapers: 'See the paper wall',
    notesTitle: 'The garden',
    notesSub: (n: number, d: number) => `${n} notes · ${d} domains · browse by kind, domain and tag`,
    notesLink: 'All notes',
    recentLabel: 'Recently updated',
    papersTitle: 'Paper wall',
    papersSub: `${papers.length} poster digests — one more with every paper read`,
    papersLink: 'Enter the paper wall',
    domainsTitle: 'Explore by domain',
    domainCountOf: (n: number) => `${n} notes`,
    domainEmpty: 'to be planted',
    searchHint: 'Search the site',
  },
}[locale];

const domainTiles = DOMAINS.map((d) => ({
  ...localized('domain', d, locale),
  // 公开口径：一个只有私密笔记的方向，对访客而言就是「待播种」——否则瓦片
  // 链向的分类页会被门禁剥空后整页 302，还顺带报出私密笔记的篇数。
  // countAll 是登录者看到的那份（全量版瓦片）。
  count: publicUnits.filter((u) => u.domains.includes(d.id)).length,
  countAll: units.filter((u) => u.domains.includes(d.id)).length,
  href: links.domain(d.id),
}));
// 每个方向出一到两张瓦片：私密笔记撑起了差额时，先出全量版（登录者看的，
// data-private-only），再出公开版（data-public-twin）；否则只出公开版
const tileRows = domainTiles.flatMap((d) => {
  const pub = { ...d, n: d.count, attrs: { 'data-public-twin': '' } };
  return d.countAll > d.count ? [{ ...d, n: d.countAll, attrs: { 'data-private-only': '' } }, pub] : [pub];
});
---

<Base
  title={t.landingTitle}
  description={t.landingDesc}
  locale={locale}
  alternates={browseAlternates('')}
  bodyClass="home"
>
  <main id="main" class="home-main">
    <section class="hero">
      <p class="eyebrow">{T.eyebrow}</p>
      <h1>Yufeng Hub</h1>
      <p class="hero-sub">{T.heroSub}</p>
      <div class="ctas">
        <a class="pill solid" href={links.all()}>{T.ctaNotes}</a>
        {PAPERS_MOUNTED && <a class="pill ghost" href={href(`${p}papers/`)}>{T.ctaPapers} <span aria-hidden="true">›</span></a>}
      </div>
      {/* a real opener, not a caption: on a phone there is no ⌘K, so the
          line itself must open the palette; the shortcut is named only
          where a keyboard is likely (fine pointer) */}
      <button class="search-hint" type="button" data-search-open>
        <span class="kbd">⌘K</span> {T.searchHint}
      </button>
    </section>

    <section class="tile">
      <div class="tile-head">
        <h2>{T.notesTitle}</h2>
        {hasPrivate && <p data-private-only>{T.notesSub(units.length, domainCountAll)}</p>}
        <p data-public-twin>{T.notesSub(publicUnits.length, domainCount)}</p>
        <a class="tile-link" href={links.all()}>{T.notesLink} <span aria-hidden="true">›</span></a>
      </div>
      <p class="strip-label">{T.recentLabel}</p>
      <ul class="recent">
        {
          recent.map((u) => {
            const d = domainOf(u);
            const ed = editionOf(u);
            return (
              <li>
                <a href={noteUrl(ed.id)}>
                  {d && <span class="chip" style={`--chip-fg:${d.tone.fg};--chip-bg:${d.tone.bg}`}>{localized('domain', d, locale).label}</span>}
                  <span class="r-title">{ed.entry.data.title}</span>
                  {ed.entry.data.description && <span class="r-desc">{ed.entry.data.description}</span>}
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* the paper wall lives on the private site only — an unmounted build
        has no tile, no covers and no link into a route that is not there */}
    {PAPERS_MOUNTED && (
      <section class="tile tile-dark">
        <div class="tile-head">
          <h2>{T.papersTitle}</h2>
          <p>{T.papersSub}</p>
          <a class="tile-link" href={href(`${p}papers/`)}>{T.papersLink} <span aria-hidden="true">›</span></a>
        </div>
        <ul class="covers">
          {
            covers.map((c) => (
              <li>
                <a href={href(`papers/${c.slug}/`)} title={c.title}>
                  <img src={c.cover} alt={c.title} loading="lazy" decoding="async" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    )}

    <section class="domains">
      <h2>{T.domainsTitle}</h2>
      <ul class="domain-grid">
        {
          /* a domain with no notes has no facet route yet — its tile stays,
             linkless, as a "to be planted" placeholder */
          tileRows.map((d) =>
            d.n > 0 ? (
              <li {...d.attrs}>
                <a href={d.href}>
                  <span class="d-label">{d.label}</span>
                  <span class="d-desc">{d.desc}</span>
                  <span class="d-count">{T.domainCountOf(d.n)} <span aria-hidden="true">›</span></span>
                </a>
              </li>
            ) : (
              <li {...d.attrs}>
                <span class="d-tile-empty">
                  <span class="d-label">{d.label}</span>
                  <span class="d-desc">{d.desc}</span>
                  <span class="d-count d-count-empty">{T.domainEmpty}</span>
                </span>
              </li>
            ),
          )
        }
      </ul>
    </section>

    <footer class="home-foot">
      <span>{t.footer}</span>
      <a href={GITHUB_URL}>GitHub</a>
    </footer>
  </main>
</Base>

<style>
  .home-main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 22px 80px;
    font-family: var(--font-ui);
  }

  /* ---- hero ---- */
  .hero {
    text-align: center;
    padding: 96px 0 72px;
  }
  .eyebrow {
    font: 600 14px/1 var(--font-ui);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 18px;
  }
  .hero h1 {
    font: 700 clamp(52px, 9vw, 88px) / 1.02 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0 0 20px;
  }
  .hero-sub {
    font: 400 clamp(17px, 2.4vw, 24px) / 1.45 var(--font-ui);
    color: var(--color-ink-soft);
    max-width: 560px;
    margin: 0 auto 30px;
    text-wrap: balance;
  }
  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 980px;
    font: 500 16px/1.2 var(--font-ui);
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .pill.solid {
    background: var(--color-accent);
    color: #fff;
  }
  .pill.solid:hover {
    background: color-mix(in srgb, var(--color-accent) 86%, #000);
  }
  .pill.ghost {
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
  }
  .pill.ghost:hover {
    background: var(--color-accent-soft);
  }
  .search-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 22px 0 0;
    padding: 8px 12px;
    border: 0;
    border-radius: 999px;
    background: none;
    font: 400 13px/1 var(--font-ui);
    color: var(--color-ink-faint);
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .search-hint:hover {
    color: var(--color-ink);
  }
  .search-hint .kbd {
    font: 500 12px/1 var(--font-ui);
  }
  @media (pointer: coarse) {
    .search-hint .kbd {
      display: none;
    }
  }

  /* ---- tiles ---- */
  .tile {
    background: var(--color-bg-soft);
    border-radius: 28px;
    padding: 52px 48px 44px;
    margin: 0 0 24px;
  }
  .tile-head h2,
  .domains h2 {
    font: 700 clamp(28px, 4.5vw, 44px) / 1.08 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 0 0 10px;
  }
  .tile-head p {
    font: 400 clamp(15px, 2vw, 19px) / 1.5 var(--font-ui);
    color: var(--color-ink-soft);
    margin: 0 0 12px;
  }
  .tile-link {
    font: 500 16px/1.2 var(--font-ui);
    color: var(--color-accent);
    text-decoration: none;
  }
  .tile-link:hover {
    text-decoration: underline;
  }

  .strip-label {
    font: 600 12px/1 var(--font-ui);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin: 34px 0 12px;
  }
  .recent {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .recent a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    background: var(--color-bg-card);
    border-radius: 18px;
    padding: 20px 22px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.6, 0.25, 1),
      box-shadow 0.25s ease;
  }
  .recent a:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .chip {
    align-self: flex-start;
    font: 600 11px/1 var(--font-ui);
    padding: 5px 10px;
    border-radius: 980px;
    color: var(--chip-fg);
    background: var(--chip-bg);
  }
  .r-title {
    font: 650 17px/1.35 var(--font-ui);
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .r-desc {
    font: 400 13.5px/1.55 var(--font-ui);
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* papers tile — dark, like an apple.com feature tile */
  .tile-dark {
    background: #1d1d1f;
  }
  .tile-dark .tile-head h2 {
    color: #f5f5f7;
  }
  .tile-dark .tile-head p {
    color: #a1a1a6;
  }
  .covers {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
  }
  .covers a {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #2c2c2e;
    transition: transform 0.25s cubic-bezier(0.2, 0.6, 0.25, 1);
  }
  .covers a:hover {
    transform: scale(1.03);
  }
  .covers img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* ---- domain grid ---- */
  .domains {
    padding: 48px 0 8px;
    text-align: center;
  }
  .domains h2 {
    margin-bottom: 28px;
  }
  .domain-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    text-align: left;
  }
  .domain-grid a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    background: var(--color-bg-soft);
    border-radius: 22px;
    padding: 28px 26px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.6, 0.25, 1),
      box-shadow 0.25s ease;
  }
  .domain-grid a:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .d-label {
    font: 700 21px/1.2 var(--font-ui);
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .d-desc {
    font: 400 14px/1.55 var(--font-ui);
    color: var(--color-ink-soft);
  }
  .d-count {
    margin-top: auto;
    font: 500 14px/1.2 var(--font-ui);
    color: var(--color-accent);
  }
  .d-tile-empty {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    background: var(--color-bg-soft);
    border-radius: 22px;
    padding: 28px 26px;
    opacity: 0.72;
  }
  .d-count-empty {
    color: var(--color-ink-faint);
  }

  /* ---- footer ---- */
  .home-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-line);
    margin-top: 44px;
    padding-top: 22px;
    font: 400 13px/1.5 var(--font-ui);
    color: var(--color-ink-faint);
  }
  .home-foot a {
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .home-foot a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .hero {
      padding: 64px 0 48px;
    }
    .tile {
      padding: 34px 24px 30px;
      border-radius: 22px;
    }
  }
</style>
