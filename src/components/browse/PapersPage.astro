---
/**
 * The paper wall, in one locale — every poster staged under public/papers/
 * as one visual card (cover WebP + title + summary), newest first. Cards
 * link to the poster pages served by this site at /papers/<slug>/; covers
 * are found at build time by listing each poster's img/ directory. Both
 * locale routes render this one component, so the language switch always
 * has a twin to land on.
 */
import { existsSync, readdirSync } from 'node:fs';

import { getCollection } from 'astro:content';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { href, type Alternate, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const papers = (await getCollection('papers'))
  .map((p) => p.data)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

/** first WebP in the poster's img/ dir, by name — the de-facto teaser figure */
const coverOf = (slug: string): string | null => {
  const dir = `public/papers/${slug}/img`;
  if (!existsSync(dir)) return null;
  const first = readdirSync(dir)
    .filter((f) => f.endsWith('.webp'))
    .sort()[0];
  return first ? href(`papers/${slug}/img/${first}`) : null;
};

const T = {
  zh: {
    title: '论文墙',
    desc: `读过论文的中文图文海报——共 ${papers.length} 篇，按时间排列，全部托管在本站。`,
    kicker: 'Paper Wall',
    heading: '论文墙',
    sub: `每读一篇论文，产出一张中文图文海报。${papers.length} 篇，全部在这里。`,
    crumb: '论文墙',
    empty: '本次构建没有挂载论文数据。',
  },
  en: {
    title: 'Paper wall',
    desc: `Poster digests of papers I've read — ${papers.length} in total, newest first, all hosted on this site.`,
    kicker: 'Paper Wall',
    heading: 'Paper wall',
    sub: `Every paper I read becomes a Chinese poster digest. All ${papers.length} of them live here.`,
    crumb: 'Paper wall',
    empty: 'This build has no paper data mounted.',
  },
}[locale];

const alternates: Alternate[] = [
  { code: 'zh', route: 'papers/' },
  { code: 'en', route: 'en/papers/' },
];
---

<BrowseLayout
  title={T.title}
  description={T.desc}
  locale={locale}
  crumbs={[{ label: T.crumb }]}
  alternates={alternates}
>
  <header class="pw-hero">
    <p class="pw-kicker">{T.kicker}</p>
    <h1 class="pw-title">{T.heading}</h1>
    <p class="pw-sub">{T.sub}</p>
  </header>

  {papers.length === 0 && <p class="pw-empty">{T.empty}</p>}

  <ul class="pw-grid">
    {
      papers.map((p) => {
        const cover = coverOf(p.slug);
        return (
          <li class="pw-card">
            <a href={href(`papers/${p.slug}/`)}>
              {cover ? (
                <span class="pw-cover">
                  <img src={cover} alt="" loading="lazy" decoding="async" />
                </span>
              ) : (
                <span class="pw-cover pw-cover-empty" aria-hidden="true">
                  ◆
                </span>
              )}
              <span class="pw-body">
                <span class="pw-meta">
                  <span>{p.date ?? ''}</span>
                  {p.arxiv_id && <span class="pw-arxiv">arXiv:{p.arxiv_id}</span>}
                </span>
                <span class="pw-name">{p.title_zh ?? p.title ?? p.title_en ?? p.slug}</span>
                {p.title_en && p.title_en !== (p.title_zh ?? p.title) && <span class="pw-name-en">{p.title_en}</span>}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</BrowseLayout>

<style>
  /* Apple 产品网格式的论文墙：居中大标题 + 封面卡片流 */
  .pw-hero {
    text-align: center;
    padding: 64px 16px 40px;
  }
  .pw-kicker {
    font: 600 13px/1 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }
  .pw-title {
    font: 700 clamp(40px, 7vw, 64px) / 1.05 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--wb-text, var(--color-ink));
    margin: 0 0 14px;
  }
  .pw-sub {
    font: 400 clamp(16px, 2.2vw, 21px) / 1.5 var(--font-ui);
    color: var(--wb-text-soft, var(--color-ink-soft));
    max-width: 640px;
    margin: 0 auto;
  }
  .pw-empty {
    text-align: center;
    font: 400 15px/1.7 var(--font-ui);
    color: var(--wb-text-soft);
  }

  .pw-grid {
    list-style: none;
    margin: 8px 0 64px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .pw-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: var(--wb-bg-card, var(--color-bg-card));
    border: 1px solid var(--wb-border-soft, var(--color-line));
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.6, 0.25, 1),
      box-shadow 0.25s ease;
  }
  .pw-card a:hover {
    transform: translateY(-3px) scale(1.005);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--wb-text, #000) 12%, transparent);
  }
  .pw-cover {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--wb-bg, var(--color-bg-soft));
    overflow: hidden;
  }
  .pw-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .pw-cover-empty {
    display: grid;
    place-items: center;
    font-size: 28px;
    color: var(--wb-border, var(--color-line));
  }
  .pw-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
  }
  .pw-meta {
    display: flex;
    gap: 10px;
    font: 500 11px/1.4 var(--font-mono);
    color: var(--wb-text-muted, var(--color-ink-faint));
  }
  .pw-name {
    font: 650 15.5px/1.4 var(--font-ui);
    letter-spacing: -0.01em;
    color: var(--wb-text, var(--color-ink));
    text-wrap: pretty;
  }
  .pw-name-en {
    font: 400 12.5px/1.45 var(--font-ui);
    color: var(--wb-text-soft, var(--color-ink-soft));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
