---
/**
 * The all-notes index in one locale — every browse unit, newest first, with
 * instant filters and the full tag index. The filter pills are links to the
 * facet pages (kind / domain / status routes); the script below swaps each
 * one for a real toggle button (aria-pressed) filtering in place (one value
 * per dimension, AND across dimensions) with an announced result count —
 * without it every pill still leads somewhere. Every locale's route renders
 * this one component with its locale.
 */
import { getCollection } from 'astro:content';
import FacetNav from 'astro-inkstone/components/wiki/FacetNav.astro';
import NoteCard from 'astro-inkstone/components/wiki/NoteCard.astro';
import BrowseLayout from '../../layouts/BrowseLayout.astro';
import { browseHrefFor, cardOf, facetBaseFor, facetsOf, localized } from '../../lib/display';
import { browseAlternates, UI, type Locale } from '../../lib/i18n';
import { isPrivate } from '../../lib/private';
import { getWikiUnits, tagIndex } from '../../lib/taxonomy';
import { DOMAINS, KINDS, STATUSES } from '../../content/notes/_meta/taxonomy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const b = UI[locale].browse;
const links = browseHrefFor(locale);

const units = await getWikiUnits(locale);
// 聚合视图只统计公开笔记：标签云和总数是从整个集合派生出来的**元数据**，
// 未登录时门禁能剥掉私密卡片，却剥不掉「这个标签存在」「一共 N 篇」——
// 那两样同样会泄漏私密笔记的存在。卡片列表本身不过滤（登录者照常看见，
// 未登录由 src/lib/vault-guard.mjs 剥掉），过滤后的实时计数走 data-count。
const publicUnits = units.filter((u) => !isPrivate(u.id));
const byId = new Map((await getCollection('notes')).map((e) => [e.id, e]));
const facets = facetsOf(publicUnits, locale);
const allTags = [...tagIndex(publicUnits).keys()];
// 筛选药丸：只有私密笔记用过的值（比如方向 infra）对访客就是「这里有你看
// 不见的东西」，点进去还会被门禁 302 到首页——这些药丸打 data-private-only，
// 门禁给访客剥掉；登录者照常能按它筛自己的私密卡片
const privateOnly = (has: (u: (typeof units)[number]) => boolean): Record<string, string> =>
  publicUnits.some(has) ? {} : { 'data-private-only': '' };
const kindDefs = KINDS.filter((k) => units.some((u) => u.kind === k.id)).map((k) => ({
  ...localized('kind', k, locale),
  attrs: privateOnly((u) => u.kind === k.id),
}));
const domainDefs = DOMAINS.filter((d) => units.some((u) => u.domains.includes(d.id))).map((d) => ({
  ...localized('domain', d, locale),
  attrs: privateOnly((u) => u.domains.includes(d.id)),
}));
const statusDefs = STATUSES.filter((s) => units.some((u) => u.status === s.id)).map((s) => ({
  ...localized('status', s, locale),
  attrs: privateOnly((u) => u.status === s.id),
}));
/** 把句子里的篇数包成 <span data-live-count>，BrowseLayout 会按真实卡片数改写 */
const liveCount = (text: string, n: number): string => {
  const at = text.lastIndexOf(String(n));
  return at < 0 ? text : `${text.slice(0, at)}<span data-live-count>${n}</span>${text.slice(at + String(n).length)}`;
};
---

<BrowseLayout title={b.all} description={b.allDesc(publicUnits.length)} locale={locale} crumbs={[{ label: b.all }]} alternates={browseAlternates('all/')}>
  <header class="wb-hero">
    <p class="wb-kicker">{b.all} <span class="sep">·</span> {b.allKicker}</p>
    <h1 class="wb-title">{b.all}<span class="en" set:html={liveCount(b.allEntries(publicUnits.length), publicUnits.length)} /></h1>
    <p class="wb-lede">{b.allLede}</p>
  </header>
  <FacetNav
    base={facetBaseFor(locale)}
    kinds={facets.kinds}
    domains={facets.domains}
    statuses={facets.statuses}
    tags={facets.tags}
    labels={facets.labels}
    active={{ dim: 'all' }}
  />

  <div class="wb-filters" data-filters>
    <span class="f-dim">{b.dimKind}</span>
    {kindDefs.map((k) => (
      <a class="f-pill" href={links.kind(k.id)} data-filter="kind" data-value={k.id} {...k.attrs}>{k.label}</a>
    ))}
    <span class="f-dim">{b.dimDomain}</span>
    {domainDefs.map((d) => (
      <a class="f-pill" href={links.domain(d.id)} data-filter="domain" data-value={d.id} {...d.attrs}>{d.label}</a>
    ))}
    <span class="f-dim">{b.dimStatus}</span>
    {statusDefs.map((s) => (
      <a class="f-pill" href={links.status(s.id)} data-filter="status" data-value={s.id} {...s.attrs}>{s.label}</a>
    ))}
    <button class="f-clear" type="button" data-clear hidden>{b.clear}</button>
    <span class="wb-count" role="status" aria-live="polite" data-count></span>
  </div>

  <ul class="wb-grid" data-cards>
    {units.map((note) => <NoteCard note={cardOf(note, locale, byId)} labels={{ chapters: b.chapters }} />)}
  </ul>
  <p class="wb-empty" data-empty hidden>{b.noMatch}</p>

  <section class="wb-tags">
    <h2 class="wb-tags-title">{b.allTags}</h2>
    {allTags.map((t) => <a class="wb-tag" href={links.tag(t)}>#{t}</a>)}
  </section>
</BrowseLayout>

<script>
  // Progressive enhancement: the anchors serve the no-JS path (each leads
  // to its facet page). Once this script owns the interaction the pills act
  // as in-place toggles, not navigation — so each anchor is swapped for a
  // real button that announces its state via aria-pressed. Card attributes
  // come from NoteCard's data-* (kind / domains / status); the live region
  // announces the count.
  const root = document.querySelector('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-cards] > li')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (root && cards.length > 0 && empty && clearBtn && count) {
    const active = new Map<string, string>(); // dimension → value (one per dimension)
    const pills = [...root.querySelectorAll<HTMLAnchorElement>('a.f-pill')].map((a) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = a.className;
      b.textContent = a.textContent;
      for (const [k, v] of Object.entries(a.dataset)) if (v !== undefined) b.dataset[k] = v;
      b.setAttribute('aria-pressed', 'false');
      a.replaceWith(b);
      return b;
    });

    const apply = (): void => {
      let shown = 0;
      for (const card of cards) {
        const ok = [...active.entries()].every(([dim, value]) => {
          if (dim === 'domain') return (card.dataset['domains'] ?? '').split(' ').includes(value);
          return card.dataset[dim] === value;
        });
        card.hidden = !ok;
        if (ok) shown += 1;
      }
      empty.hidden = shown > 0;
      clearBtn.hidden = active.size === 0;
      count.textContent = active.size === 0 ? '' : `${shown} / ${cards.length}`;
      for (const p of pills) {
        const on = active.get(p.dataset['filter'] ?? '') === p.dataset['value'];
        p.toggleAttribute('data-on', on);
        p.setAttribute('aria-pressed', String(on));
      }
    };

    for (const p of pills) {
      p.addEventListener('click', () => {
        const dim = p.dataset['filter'] ?? '';
        const value = p.dataset['value'] ?? '';
        if (active.get(dim) === value) active.delete(dim);
        else active.set(dim, value);
        apply();
      });
    }
    clearBtn.addEventListener('click', () => {
      active.clear();
      // clearing hides this button, so focus moves to the first filter pill
      // first — keyboard focus must never rest on a hidden element
      pills[0]?.focus();
      apply();
    });
  }
</script>
