---
/**
 * Note page: Base shell + sidebar + reading column.
 *
 * The column's order is the wiki's: the taxonomy strip, the hub crumb when
 * the note is a chapter, the note itself (which opens with its own <Hero>
 * or <PartHero>), the linked mentions, prev/next for chapters, small print.
 *
 * `main.note-main > .col` is astro-inkbrush's mount contract for the comment
 * section — keep the pair intact. The taxonomy strip carries the engine's
 * frontmatter slot: in editing mode its ✎ opens the note's frontmatter as
 * YAML.
 */
import Backlinks from 'astro-inkstone/components/Backlinks.astro';
import LocalGraph, { type LocalGraphNeighbor } from 'astro-inkstone/components/LocalGraph.astro';
import PageFooter from 'astro-inkstone/components/PageFooter.astro';
import TaxonomyLine from 'astro-inkstone/components/wiki/TaxonomyLine.astro';
import type { DomainDisplay, KindDisplay, StatusDisplay } from 'astro-inkstone/lib/wiki-display';
import type { BacklinkItem } from 'astro-inkstone/lib/backlinks';
import type { TocData } from 'astro-inkstone/lib/toc-types';
import Base from './Base.astro';
import Sidebar, { type HubNav } from '../components/Sidebar.astro';
import { DEFAULT_LOCALE, UI, type Alternate, type Locale } from '../lib/i18n';

interface Crumb {
  label: string;
  route?: string | undefined;
}

/** auto-generated chrome for hub chapter pages */
export interface HubPageChrome {
  /** "Part II · Wiki & browse" — shown in the in-column crumb */
  crumbLabel: string;
  hubHref: string;
  prev?: { href: string; label: string } | undefined;
  next?: { href: string; label: string } | undefined;
}

/** display-ready taxonomy strip data (assembled by the route) */
export interface TaxonomyStrip {
  kind?: KindDisplay | undefined;
  domains: DomainDisplay[];
  status?: StatusDisplay | undefined;
  updated?: string | undefined;
  reading?: string | undefined;
}

interface Props {
  title: string;
  description?: string | undefined;
  locale: Locale;
  crumbs: Crumb[];
  /** sidebar brand line (the note's short title) and its link */
  brand: string;
  brandHref: string;
  subtitle?: string | undefined;
  noteId?: string | undefined;
  /** this page's routes in the locales it exists in */
  alternates: Alternate[];
  toc: TocData;
  tocDepth?: 2 | 3;
  taxonomy?: TaxonomyStrip | undefined;
  /** the mark a private note wears on its meta strip (the vault's badge
   *  string, already in the page's language); absent for a public note.
   *  It rides in as a data attribute so the strip stays the engine's
   *  presentational component and the site keeps the wording. */
  privateBadge?: string | undefined;
  hub?: HubNav | undefined;
  hubPage?: HubPageChrome | undefined;
  backlinks?: BacklinkItem[] | undefined;
  /** one-hop link neighbourhood for the sidebar graph; empty = no panel */
  graph?: LocalGraphNeighbor[] | undefined;
  /** the note's raw source (frontmatter + body). Present ⇒ the column opens
   *  with a "copy source" control that puts these bytes on the clipboard —
   *  the hand-off to an external AI assistant, since none is embedded. The
   *  payload rides in a <template>: inert markup, HTML-escaped by Astro,
   *  read back as text by the click handler in Base.astro. */
  source?: string | undefined;
}
const {
  title,
  description,
  locale,
  crumbs,
  brand,
  brandHref,
  subtitle,
  noteId,
  alternates,
  toc,
  tocDepth = 2,
  taxonomy,
  privateBadge,
  hub,
  hubPage,
  backlinks = [],
  graph = [],
  source,
} = Astro.props;
const t = UI[locale];
---

<Base
  title={title}
  description={description}
  locale={locale}
  crumbs={crumbs}
  alternates={alternates}
  noteId={noteId}
  hasSidebar
>
  <div class="layout">
    <Sidebar brand={brand} brandHref={brandHref} subtitle={subtitle} toc={toc} tocDepth={tocDepth} hub={hub} labels={{ contents: t.contents }}>
      {graph.length > 0 && <LocalGraph centerTitle={title} neighbors={graph} label={t.localGraph} />}
    </Sidebar>
    <main class="note-main" id="main">
      <div class="col">
        {
          source !== undefined && (
            <div class="note-tools">
              <button type="button" class="copy-source" title={t.copySourceTitle} data-done={t.sourceCopied}>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path
                    d="M5.5 2.5h6a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1zM3.5 5v7.5a1 1 0 0 0 1 1H10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="lbl">{t.copySource}</span>
                <span class="done">{t.sourceCopied}</span>
                <span class="fail">{t.copyFailed}</span>
              </button>
              <template data-note-source set:text={source} />
            </div>
          )
        }
        {
          taxonomy && (
            <TaxonomyLine
              kind={taxonomy.kind}
              domains={taxonomy.domains}
              status={taxonomy.status}
              updated={taxonomy.updated}
              reading={taxonomy.reading}
              labels={{ updated: t.updated }}
              data-private={privateBadge}
              data-inkbrush-slot="frontmatter"
            />
          )
        }
        {
          hubPage && (
            <div class="crumb">
              <a href={hubPage.hubHref}>{t.hub}</a>
              <span class="sep">›</span>
              {hubPage.crumbLabel}
            </div>
          )
        }
        <slot />
        {
          backlinks.length > 0 && (
            <Backlinks
              items={backlinks}
              heading={t.backlinks}
              sub={locale !== DEFAULT_LOCALE ? UI[DEFAULT_LOCALE].backlinks : ''}
            />
          )
        }
        {
          hubPage && (hubPage.prev || hubPage.next) && (
            <nav class="pagination" aria-label={t.chapterNav}>
              {/* only the cards that exist are rendered — the grid's auto-fit
                  lets a lone card fill the whole row */}
              {hubPage.prev && (
                <a class="prev" href={hubPage.prev.href} rel="prev">
                  <div class="dir">{t.prev}</div>
                  <div class="title">{hubPage.prev.label}</div>
                </a>
              )}
              {hubPage.next && (
                <a class="next" href={hubPage.next.href} rel="next">
                  <div class="dir">{t.next}</div>
                  <div class="title">{hubPage.next.label}</div>
                </a>
              )}
            </nav>
          )
        }
        <PageFooter>
          <p>{t.footer}</p>
        </PageFooter>
      </div>
    </main>
  </div>
</Base>
